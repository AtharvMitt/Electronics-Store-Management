# Copy this file to .env in the repository root. Never commit .env.
PORT=5000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27018/techzone?replicaSet=techzone-dev
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/techzone_test?replicaSet=techzone-dev
# The db:start helper manages only a loopback development instance on this port.
DEV_MONGODB_PORT=27018
